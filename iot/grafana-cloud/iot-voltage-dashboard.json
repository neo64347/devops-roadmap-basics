{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Supabase PostgreSQL",
      "description": "Choose the PostgreSQL data source connected to Supabase.",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.1.0"
    },
    {
      "type": "datasource",
      "id": "postgres",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "title": "IoT Sensor Voltage",
  "uid": "iot-voltage",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Voltage by sensor",
      "description": "Voltage readings stored in Supabase PostgreSQL.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(recorded_at, '5m'),\n  AVG(voltage_v) AS value,\n  sensor_id AS metric\nFROM voltage_readings\nWHERE $__timeFilter(recorded_at)\nGROUP BY 1, sensor_id\nORDER BY 1",
          "editorType": "sql"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
