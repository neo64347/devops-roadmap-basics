# Copy this file to .env and replace placeholders with your credentials.
# Supabase PostgreSQL connection string; URL-encode special characters in the password.
IOT_DATABASE_URL=postgresql://iot_writer:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require

# MQTT broker connection string. Use mqtts:// for TLS (recommended outside local demos).
IOT_MQTT_URL=mqtts://YOUR_MQTT_USER:YOUR_MQTT_PASSWORD@YOUR_MQTT_HOST:8883
